# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Funciona tanto no servidor Node como na Vercel)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# VITE_ PREFIXED VARIABLES FOR VERCEL FRONTEND CLIENT-SIDE SYNC
# Na Vercel (Environment Variables), adicione também estas variáveis para que o frontend salve diretamente no Supabase:
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

