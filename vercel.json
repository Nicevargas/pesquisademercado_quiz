{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/leads",
      "destination": "/api/leads.ts"
    },
    {
      "source": "/api/diagnostico",
      "destination": "/api/diagnostico.ts"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.ts"
    }
  ]
}
